<div class="container">
    <div class="admin-header">
        <h2>Print requests</h2>
    </div>

    {{#if success}}<div class="alert alert-success">{{success}}</div>{{/if}}
    {{#if error}}<div class="alert alert-danger">{{error}}</div>{{/if}}

    {{#if discord.available}}
        <div class="admin-section">
            {{#if discord.linked}}
                <div style="display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap;">
                    <span>Your Discord account <strong>{{discord.username}}</strong> is linked: clicking <strong>Claim</strong> under a request announcement in Discord claims it for you.</span>
                    <form method="POST" action="/discord/unlink" style="margin:0;">
                        <button type="submit" class="btn btn-sm btn-secondary">Unlink</button>
                    </form>
                </div>
            {{else}}
                <div style="display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap;">
                    <span>New requests are announced in Discord, where you can claim one with the <strong>Claim</strong> button. For that to count, link your Discord account first:</span>
                    <a href="/discord/link" class="btn btn-sm btn-primary">Link Discord account</a>
                </div>
            {{/if}}
        </div>
    {{/if}}

    {{#> requestTable heading="Open" rows=open empty="Nothing waiting. Nice."}}{{/requestTable}}
    {{#> requestTable heading="In progress" rows=claimed empty="Nothing claimed right now."}}{{/requestTable}}
    {{#> requestTable heading="Completed" rows=completed empty="Nothing completed yet."}}{{/requestTable}}
</div>

{{#*inline "requestTable"}}
<div class="admin-section">
    <h3>{{heading}}</h3>
    {{#if rows.length}}
        <div class="recent-table">
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>From</th>
                        <th>Type</th>
                        <th>Size</th>
                        <th>Needed by</th>
                        <th>Claimed by</th>
                        <th>Submitted</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {{#each rows}}
                    <tr>
                        <td>{{requestId}}</td>
                        <td>{{name}}</td>
                        <td>{{printTypeLabel}}</td>
                        <td>{{#if desiredSize}}{{desiredSize}}{{#if strictSize}} <span class="status-badge pending" title="Sizing is strict">strict</span>{{/if}}{{else}}<span class="text-muted">—</span>{{/if}}</td>
                        <td>{{neededBy}}</td>
                        <td>{{#if claimedBy}}{{#if claimedByMe}}You{{else}}{{claimedBy.name}}{{/if}}{{else}}<span class="text-muted">—</span>{{/if}}</td>
                        <td>{{formatDate createdAt}}</td>
                        <td><a href="/requests/{{requestId}}" class="btn btn-sm btn-primary">Open</a></td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    {{else}}
        <p class="no-data">{{empty}}</p>
    {{/if}}
</div>
{{/inline}}
