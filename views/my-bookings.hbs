<div class="container">
    <h2>My Events</h2>

    <div class="btn-group">
        <a href="/book" class="btn btn-primary">Book New Session</a>
        <a href="/" class="btn">Back to Home</a>
    </div>

    {{#if bookings}}
        <div class="bookings-section">
            <h3>Upcoming</h3>
            <table>
                <thead>
                    <tr>
                        <th>Date & Time</th>
                        <th>Event</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each bookings}}
                    <tr>
                        <td data-label="Date & Time">{{formatSlot this.slot}}</td>
                        <td data-label="Event">{{this.eventName}}</td>
                        <td data-label="Actions">
                            {{#if this.cancellable}}
                                <a href="/cancel-booking/{{this.timeslotId}}"
                                   class="btn btn-sm btn-danger">
                                   Cancel
                                </a>
                            {{/if}}
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>

        {{#if pastBookings}}
            <div class="bookings-section">
                <h3>Past</h3>
                <table>
                    <thead>
                        <tr>
                            <th>Date & Time</th>
                            <th>Event</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each pastBookings}}
                        <tr>
                            <td data-label="Date & Time">{{formatSlot this.slot}}</td>
                            <td data-label="Event">{{this.eventName}}</td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        {{/if}}
    {{else}}
        <div class="no-bookings">
            <p>You don't have any events yet.</p>
            <a href="/book" class="btn btn-primary">Book Your First Session</a>
        </div>
    {{/if}}
</div>
