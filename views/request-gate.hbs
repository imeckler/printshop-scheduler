<div class="container">
    <div class="admin-login-form" style="margin: 3rem auto;">
        <h2>Print job submission</h2>
        <p>This form is for people who were given the link and password by the print squad.</p>
        {{#if error}}
            <div class="alert alert-danger">Incorrect password</div>
        {{/if}}
        <form method="POST" action="/request/gate">
            <div class="form-group">
                <input type="password" name="password" placeholder="Password" required autofocus>
            </div>
            <button type="submit" class="btn btn-primary" style="width:100%">Continue</button>
        </form>
    </div>
</div>
